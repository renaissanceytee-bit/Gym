EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# RevenueCat: configure products/entitlements in both app stores and RevenueCat first
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_PLUS_PRODUCT_ID=ascend_plus_monthly
EXPO_PUBLIC_REVENUECAT_PRO_PRODUCT_ID=ascend_pro_monthly

# AdMob app IDs are build-time values; banner unit IDs are runtime values.
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=
